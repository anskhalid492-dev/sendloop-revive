# MunchReach — production environment template.
# NO VALUES HERE. Fill them in your host's secret store
# (Cloudflare: `wrangler secret put NAME`; Node host: env vars).
#
# NOTE: PROVIDER_CREDENTIALS_KEY must be BYTE-IDENTICAL to the current
# production value or every stored provider/AI credential fails to decrypt.

# ---- Build-time (must be set BEFORE `bun run build`; baked into the client) ----
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_APP_URL=https://munchreach.com

# ---- Application ----
NODE_ENV=production
APP_URL=https://munchreach.com
PUBLIC_APP_URL=https://munchreach.com

# ---- Database / auth (Phase 5: keep CURRENT production project) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SB_SERVICE_ROLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # alternative name, either is accepted

# ---- Encryption ----
PROVIDER_CREDENTIALS_KEY=

# ---- Cron auth secrets ----
CAMPAIGN_CRON_SECRET=
WARMUP_CRON_SECRET=
DOMAIN_CRON_SECRET=
PROVIDER_HEALTH_CRON_SECRET=
TRANSACTIONAL_CRON_SECRET=

# ---- Inbound / webhook verification ----
INBOUND_EMAIL_SECRET=
INBOUND_WEBHOOK_SIGNING_SECRET=
SVIX_SIGNING_SECRET=
RESEND_WEBHOOK_SECRET=

# ---- Referral ----
REFERRAL_BILLING_SECRET=
REFERRAL_HASH_SALT=

# ---- Sending DNS instructions shown to customers ----
SENDING_DNS_HOST=
SENDING_MX_HOST=
SENDING_SPF_INCLUDE=
SENDING_DKIM_HOST=
SENDING_DMARC_RUA=
SENDING_TRACKING_HOST=

# ---- Email providers (only the ones actually enabled) ----
RESEND_API_KEY=
MAILGUN_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
POSTMARK_API_KEY=
ZEPTOMAIL_API_KEY=
EMAILIT_API_KEY=
AWS_REGION=

# ---- Optional platform AI ----
LOVABLE_API_KEY=
